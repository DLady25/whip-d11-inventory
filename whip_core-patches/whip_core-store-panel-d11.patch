 -- ============================================
+-- D11 (whip_core-store-panel-d11): abrir item-painel que esta num store (bolsa no porta-malas, numa stash)
+-- ============================================
+-- O cliente manda o store como o renderer o conhece ('vehicle:<id>:trunk|glovebox' ou 'container:<id>') e o slot.
+-- Vale o que vale para mover ali (Stores.fromWire: aberto por este jogador, perto, nao so-leitura), e so um jogador
+-- por vez na mesma bolsa: dois paineis gravariam um por cima do outro.
+SecureEvent('whip_core:server:openStorePanel', {
+    rateLimit = 500,
+    params = { {'storeId', 'string', 64}, {'slot', 'int', 1, 1000} },
+}, function(source, player, storeId, slot)
+    if not player.inventory then return end
+    local kind, id, sub = storeId:match('^(vehicle):(%d+):(%a+)$')
+    if not kind then kind, id = storeId:match('^(container):(%d+)$') end
+    if not kind then return false, 'Isso não abre aqui' end
+    local where = { kind = kind, id = tonumber(id), sub = sub }
+    local store, s, err = Stores.fromWire(source, { kind = kind, id = where.id, sub = sub, slot = slot })
+    if not store then return false, err or 'Isso não está aberto para você' end
+    local sd = store.kind.get(store.handle, s)
+    if not sd or not sd.item then return false, 'O item não existe mais' end
+
+    local def = Config.Items[sd.item]
+    local byItem = def and def.defaultAction and _panelItemActions[def.defaultAction]
+    local opener = byItem and byItem[sd.item]
+    if not opener then
+        for _, list in pairs(_panelItemActions) do
+            if list[sd.item] then opener = list[sd.item] break end
+        end
+    end
+    if not opener then return false, 'Isso não abre' end
+
+    local uid = sd.metadata and sd.metadata.uid
+    for src, mine in pairs(Panels._sessions) do
+        if src ~= source then
+            for _, sess in pairs(mine) do
+                local h = sess.host
+                if h and h.container == 'store' and h.store and h.store.kind == kind and tostring(h.store.id) == id
+                    and h.store.sub == sub and (h.slot == s or (uid ~= nil and h.uid == uid)) then
+                    return false, 'Outra pessoa está mexendo nisso'
+                end
+            end
+        end
+    end
+
+    -- O painel segue a bolsa pelo uid (Panels.resolveHost): sem uid, ganha um, gravado no store.
+    if uid == nil then
+        local okU = Stores.setItemMetadataAt({ kind = kind, id = where.id, sub = sub, slot = s }, { uid = Log.newUid() })
+        if not okU then return false, 'Não deu para abrir agora' end
+        sd = store.kind.get(store.handle, s)
+        if not sd or not sd.item then return false, 'O item não existe mais' end
+    end
+    opener(source, player, sd, 'store', s, where)
+end)
