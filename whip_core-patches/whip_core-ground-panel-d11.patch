 -- like any other move.
 
 -- ============================================
+-- D11: abrir item-painel que esta no chao (bolsa largada, como o dropcontainer do ox_inventory D12)
+-- ============================================
+-- O renderer pede pelo id da pilha. Ao alcance, parada, e so um jogador por vez: dois paineis sobre a mesma pilha
+-- gravariam um por cima do outro.
+SecureEvent('whip_core:server:openGroundPanel', {
+    rateLimit = 500,
+    params = { {'groundItemId', 'id'} },
+}, function(source, player, groundItemId)
+    if not player.inventory then return end
+    local g = GroundItems.getById(groundItemId)
+    if not g or g.flight then return false, 'O item não existe mais' end
+    if not IsPlayerNear(source, g.x, g.y, g.z, (Config.GroundItemPickupRange or 2.0) + 2.0) then
+        return false, 'Longe demais'
+    end
+
+    local def = Config.Items[g.item]
+    local byItem = def and def.defaultAction and _panelItemActions[def.defaultAction]
+    local opener = byItem and byItem[g.item]
+    if not opener then
+        for _, list in pairs(_panelItemActions) do
+            if list[g.item] then opener = list[g.item] break end
+        end
+    end
+    if not opener then return false, 'Isso não abre' end
+
+    for src, mine in pairs(Panels._sessions) do
+        if src ~= source then
+            for _, s in pairs(mine) do
+                if s.host and s.host.container == 'ground' and s.host.slot == groundItemId then
+                    return false, 'Outra pessoa está mexendo nisso'
+                end
+            end
+        end
+    end
+
+    Log.ensureUid(g)   -- o painel segue a bolsa pelo uid se ela for pega (Panels.resolveHost)
+    opener(source, player, g, 'ground', groundItemId)
+end)
+
+-- ============================================
