D12: andar e dirigir com o inventario aberto, so no teclado (aplicar depois de whip_core-inventory-noblur-d11.patch).
A pe: WASD e Shift; motorista: WASD e espaco; controle: tudo bloqueado (o analogico e do cursor). Camera: setr whip_inventory_drive_look 1.
Aplicar em resources/: patch -p1 < whip_core-inventory-drive-d11.patch

--- a/whip_core/client/controller.lua
+++ b/whip_core/client/controller.lua
@@ -548,6 +548,15 @@
 --- those panels hold NUI focus, so their keyboard and mouse were not reaching gameplay anyway.
 local DRIVE_BLOCK = { all = true }
 
+-- D12: the driver keeps driving with the inventory open (client/inventory.lua, InventoryDriveKeys). The block lets
+-- the driving keys through, and is rebuilt when the device changes (the keys differ on a pad).
+local blockFor = nil   -- the device the padNav block was built for (true pad, false keyboard), nil: plain block
+local function padNavBlock()
+    local keys = InventoryDriveKeys and InventoryDriveKeys() or nil
+    blockFor = keys and padActive or nil
+    return keys and { all = true, except = keys } or DRIVE_BLOCK
+end
+
 --- One frame of driving: the device, and the nav a pad sends.
 local function DriveFrame()
     -- Inline, not on the watcher's 200ms tick: the press about to be read below may be the very
@@ -654,12 +663,17 @@
 local function DriveHook()
     if not ShouldDrive() then StopDriver() return end
     DriveFrame()
+    -- D12: driving with the inventory open, and the device changed: the driving keys change with it.
+    if blockFor ~= nil and blockFor ~= padActive then
+        ControlBlocks.hold('padNav', padNavBlock(), DriveHook)
+        if InventoryDriveSync then InventoryDriveSync() end
+    end
 end
 
 local function RunDriver()
