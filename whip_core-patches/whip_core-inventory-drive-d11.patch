+-- D12: andar e dirigir com o inventario aberto (docs/patches/whip_core-inventory-drive-d11.patch; o ox_inventory
+-- D12 fazia o mesmo). So no teclado: o foco guarda a entrada do jogo (keepInput) e o bloco 'invDrive' segura todo
+-- controle menos os de mover; o 'padNav' (client/controller.lua) solta os mesmos. A pe: WASD e Shift. Motorista:
+-- WASD e espaco. No controle nada passa (o analogico e do cursor). Camera (mouse): setr whip_inventory_drive_look 1.
+local MOVE_KEYS = { foot = { 21, 30, 31, 32, 33, 34, 35 }, drive = { 59, 60, 63, 64, 71, 72, 76 } }
+local invMoving = nil   -- 'foot' | 'drive' | nil, decidido ao abrir
+
+local function moveMode()
+    local ped = PlayerPedId()
+    if IsEntityDead(ped) == true or IsEntityDead(ped) == 1 then return nil end
+    local veh = GetVehiclePedIsIn(ped, false)
+    if veh == 0 then return 'foot' end
+    return GetPedInVehicleSeat(veh, -1) == ped and 'drive' or nil
+end
+
+--- As teclas de mover que o inventario aberto deixa passar agora ({} no controle), ou nil (nada a soltar).
+---@return integer[]|nil
+function InventoryDriveKeys()
+    if not invMoving then return nil end
+    if WhipPadActive then return {} end
+    local keys = { table.unpack(MOVE_KEYS[invMoving]) }
+    if GetConvarInt('whip_inventory_drive_look', 0) == 1 then keys[#keys + 1] = 1; keys[#keys + 1] = 2 end
+    return keys
+end
+
+--- Segura (ou solta) o bloco 'invDrive' conforme InventoryDriveKeys.
+function InventoryDriveSync()
+    local keys = InventoryDriveKeys()
+    -- 199/200 nomeados: o Esc e do inventario, nao abre o menu de pausa (client/pause.lua, heldByOthers).
+    if keys then ControlBlocks.hold('invDrive', { all = true, except = keys, controls = { 199, 200 } })
+    else ControlBlocks.release('invDrive') end
+end
+
