 export function adoptSlotDefs(payload) {
     if (!payload) return;
     if (Array.isArray(payload.accessorySlots)) slotConfig.accessorySlots = payload.accessorySlots;
     if (Array.isArray(payload.ignitionKeys)) slotConfig.ignitionKeys = payload.ignitionKeys;
+    // D11: Lua sends a table with holes as an object ({ "1": ... }), so read it by key either way
+    if ('hotbar' in payload) slotConfig.hotbar = payload.hotbar || null;
+    if (invHotbarHooks) invHotbarHooks.syncHotbar();
+}
+
+/** D11: what number key i (1-5) uses, as the item in it: Config.HotbarSlots' slot, or pocket slot i. */
+export function hotbarSlotData(i) {
+    const map = slotConfig.hotbar;
+    const t = map && (Array.isArray(map) ? map[i - 1] : map[String(i)]);
+    const container = (t && t.container) || 'player';
+    const slot = (t && t.slot) || i;
+    return inv.state && inv.state[container] && inv.state[container][String(slot)];
 }
 
