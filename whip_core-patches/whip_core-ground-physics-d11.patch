 end
 
+--- D11 patch (docs/patches/whip_core-ground-physics-d11.patch, LGPL): a pile moved by a resource, keeping its id (the
+--- prompt and anything that knows the id follow). Like settle, without a flight: the row, the cache and every client
+--- that can see either spot move to the new pose, drawn exactly ({ rx, ry } tilt, as a placed pile).
+---@param id number
+---@param coords vector3|table
+---@param heading number|nil
+---@param rx number|nil
+---@param ry number|nil
+---@return boolean ok
+---@return string|nil err
+function GroundItems.move(id, coords, heading, rx, ry)
+    id = tonumber(id)
+    local data = id and GroundItems.cache[id]
+    if not data then return false, 'Item not found' end
+    if GroundItems._flights[id] then return false, 'Still flying' end
+    local x, y, z = tonumber(coords and coords.x), tonumber(coords and coords.y), tonumber(coords and coords.z)
+    if not (x and y and z) then return false, 'MoveGroundItem needs coords' end
+    rx, ry = tonumber(rx) or 0.0, tonumber(ry) or 0.0
+    local ok, err = pcall(MySQL.update.await,
+        'UPDATE `ground_items` SET `x` = ?, `y` = ?, `z` = ?, `heading` = ?, `placed` = 1, `rx` = ?, `ry` = ? WHERE `id` = ?',
+        { x, y, z, heading or 0.0, rx, ry, id })
+    if not ok then return false, tostring(err) end
+    if GroundItems.cache[id] ~= data then return false, 'Item not found' end   -- picked up while the write waited
+    local fromX, fromY = data.x, data.y
+    data.x, data.y, data.z = x, y, z
+    data.heading = heading or 0.0
+    data.placed, data.rx, data.ry = true, rx, ry
+    GroundItems.gridRemove(id)
+    GroundItems.gridInsert(id, x, y)
+    announceSettled(data, fromX, fromY)
+    return true
+end
+exports('MoveGroundItem', GroundItems.move)
+
 -- THE WATCHDOG for throws whose thrower never says where they landed (a crash, a disconnect, the
 -- object lost). After FLIGHT_MAX_MS, or as soon as the object or its thrower is gone, the pile is
 -- settled where the server last saw it, snapped upright. Asleep while nothing is in the air.
