+-- D11 patch (docs/patches/whip_core-ground-physics-d11.patch, LGPL): a resource may HOLD a pile's prop (HoldGroundProp)
+-- while it draws and moves the pile itself (d11_ptrunk: the pile as a physics object). Held, whip draws no prop and
+-- no prompt for it; let go, it is drawn again where the pile now lies.
+local groundHeld = {}   -- [id] = resource holding it
+
 local function SpawnGroundProp(data)
     if groundItemProps[data.id] or spawning[data.id] then return end  -- already spawned, or on its way
+    if groundHeld[data.id] then return end
 
     -- Still flying (a throw): the pile is the thrower's networked object for now, so no
     -- prop of our own — only its prompt, following that object so anyone in reach can grab it out of
@@ -843,6 +849,32 @@ RegisterNetEvent('whip_core:client:groundItemUpdated', function(id, amount)
     if onMyPanel(known) then RefreshNUIGroundItems() end
 end)
 
+-- D11 patch (whip_core-ground-physics-d11): HoldGroundProp(id, true) takes the pile's prop and prompt off this
+-- screen until HoldGroundProp(id, false); a resource that stops lets go of everything it held.
+exports('HoldGroundProp', function(id, held)
+    id = tonumber(id)
+    if not id then return false end
+    if held then
+        groundHeld[id] = GetInvokingResource() or 'whip_core'
+        DespawnGroundProp(id)
+    else
+        groundHeld[id] = nil
+        local data = groundItemsData[id]
+        if data and not groundItemProps[id] and inStreamRange(data) then SpawnGroundProp(data) end
+    end
+    return true
+end)
+
+AddEventHandler('onResourceStop', function(res)
+    for id, holder in pairs(groundHeld) do
+        if holder == res then
+            groundHeld[id] = nil
+            local data = groundItemsData[id]
+            if data and not groundItemProps[id] and inStreamRange(data) then SpawnGroundProp(data) end
+        end
+    end
+end)
+
